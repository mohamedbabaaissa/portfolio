# Copy this file to .env

# Your secret admin address, e.g. yoursite.com/my-private-door  (built into the site, redeploy after changing it)
VITE_ADMIN_PATH=ramona

# Where the backend lives.
# Leave EMPTY while developing (the dev server forwards /api to the backend on port 3001).
# Online: the backend address, e.g. https://my-portfolio-api.onrender.com
VITE_API_URL=

# Dev only: backend address used by the dev server proxy
VITE_PROXY_TARGET=http://localhost:3001
